[Unit]
Description=Kylin Ops Backend (FastAPI)
Wants=network-online.target kylin-mcp-server.service kylin-bert.service
After=network-online.target kylin-mcp-server.service kylin-bert.service
Conflicts=kylin-backend.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Bert/program2
EnvironmentFile=/home/ubuntu/Bert/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/ubuntu/Bert/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/Bert/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kylin-ops-backend

[Install]
WantedBy=multi-user.target
