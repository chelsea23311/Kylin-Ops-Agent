[Unit]
Description=Kylin MCP Protocol TCP Server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Bert/program2
EnvironmentFile=/home/ubuntu/Bert/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/ubuntu/Bert/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/Bert/venv/bin/python -m app.services.mcp_protocol_server
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kylin-mcp-server

[Install]
WantedBy=multi-user.target
