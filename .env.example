# Copy to .env in the repository root. Never commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
OPERATOR_REGISTER_KEY=
AUDITOR_REGISTER_KEY=
APPROVE_SECRET=

# Required for AI planning and resource analysis.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional local overrides; defaults work with the documented directory layout.
# DATABASE_URL=sqlite:////absolute/path/to/kylin_ops.db
